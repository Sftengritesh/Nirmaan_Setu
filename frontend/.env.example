# NirmaanSetu Environment Variables Template
# Public Web App & Mobile Build Configuration

# Base URL of the deployed Spring Boot Backend API (e.g., https://api.nirmaansetu.in or https://nirmaansetu-backend.onrender.com)
# Leave blank for local development using the Vite dev proxy
VITE_API_BASE_URL=

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Optional: Firebase Config (Only needed if utilizing Firebase Cloud Messaging push notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

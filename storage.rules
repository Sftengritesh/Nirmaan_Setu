rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Site Photos & Attendance Selfies
    match /uploads/{fileName} {
      allow read: if isAuthenticated();
      // Allow image uploads up to 5MB
      allow write: if isAuthenticated() && 
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
    }

    // Generated Invoices & Documents
    match /documents/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                   request.resource.size < 10 * 1024 * 1024 &&
                   (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*'));
    }
  }
}
